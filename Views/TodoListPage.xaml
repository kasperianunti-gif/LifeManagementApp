<ContentPage
    x:Class="LifeManagementApp.Views.TodoListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:LifeManagementApp.Models"
    xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
    x:DataType="vm:TodoListViewModel"
    Title="Tehtävät">
    <Grid Padding="24" RowDefinitions="Auto,*" RowSpacing="12">
        <VerticalStackLayout Spacing="8">
            <Label Text="Tehtävät" Style="{StaticResource Heading}" />
            <FlexLayout Wrap="Wrap">
                <Button Text="Lisää tehtävä" Command="{Binding AddTodoCommand}" Margin="0,0,8,8" />
                <Button Text="Muokkaa valittua" Command="{Binding EditTodoCommand}" Margin="0,0,8,8" />
            </FlexLayout>
            <FlexLayout Wrap="Wrap">
                <Button Text="Prioriteetti" Command="{Binding LoadCommand}" CommandParameter="priority" Margin="0,0,8,8" />
                <Button Text="Eräpäivä" Command="{Binding LoadCommand}" CommandParameter="date" Margin="0,0,8,8" />
            </FlexLayout>
            <Label Text="{Binding SortText}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource Error}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Todos}"
                        EmptyView="Ei tehtäviä. Lisää ensimmäinen tehtävä."
                        SelectionMode="Single" SelectedItem="{Binding SelectedTodo, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <VerticalStackLayout Padding="8" Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <FlexLayout Wrap="Wrap">
                            <Label Text="{Binding Priority, StringFormat='Prioriteetti {0}'}" Margin="0,0,12,0" />
                            <Label Text="{Binding DueDate, StringFormat='Eräpäivä {0:dd.MM.yyyy}'}" Margin="0,0,12,0" />
                            <Label Text="{Binding IsDone, Converter={StaticResource DoneText}, Mode=OneWay}" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
