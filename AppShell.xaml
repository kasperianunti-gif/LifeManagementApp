<Shell
    x:Class="LifeManagementApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LifeManagementApp.Views"
    FlyoutBehavior="Disabled">
    <TabBar>
        <ShellContent Title="Etusivu" Route="home"
                      ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Tehtävät" Route="todos"
                      ContentTemplate="{DataTemplate views:TodoListPage}" />
    </TabBar>
</Shell>
